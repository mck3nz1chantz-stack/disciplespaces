# DiscipleSpaces — optional public Vite config (no secrets).
# Copy to a local-only file if you need overrides; do not commit real secrets.
# Project-health secrets-smoke fails on .env* filenames — prefer defaults in src/.

# Space room relay Worker (leave empty for fully local / no Connect network)
VITE_SPACE_RELAY_URL=https://disciple-spaces-relay.mck3nz1-chantz.workers.dev

# Canonical origin users should bookmark (IndexedDB is per-origin)
# Dev example: http://localhost:5173
VITE_CANONICAL_ORIGIN=https://disciple-spaces.pages.dev

# Optional: AppHub bug ingest (loopback only; local operator tooling)
# VITE_APPHUB_INGEST_URL=http://127.0.0.1:8767/api/bugs/ingest
